{
  "name": "openclaw-plugin-gemini-transcribe",
  "version": "0.1.0",
  "description": "OpenClaw media-understanding plugin for Gemini 3.5 Transcribe (Google Interactions API).",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --config ./vitest.config.ts",
    "validate": "npm run build && clawhub package validate . --out .clawhub-validation"
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md"
  ],
  "peerDependencies": {
    "openclaw": ">=2026.10.9"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "devDependencies": {
    "clawhub": "latest",
    "openclaw": "latest",
    "typescript": "7.0.2",
    "vitest": "^3.2.0"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.10.9"
    },
    "build": {
      "openclawVersion": "2026.10.9"
    },
    "install": {
      "clawhubSpec": "clawhub:openclaw-plugin-gemini-transcribe",
      "defaultChoice": "clawhub",
      "minHostVersion": ">=2026.10.9"
    },
    "release": {
      "publishToClawHub": true
    }
  },
  "pluginInspector": {
    "version": 1,
    "plugin": {
      "id": "gemini-transcribe",
      "priority": "high",
      "seams": [
        "plugin-runtime"
      ],
      "sourceRoot": ".",
      "expect": {
        "registrations": [
          "registerMediaUnderstandingProvider"
        ]
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/ajk0x00/openclaw-gemini-stt-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/ajk0x00/openclaw-gemini-stt-plugin/issues"
  },
  "homepage": "https://github.com/ajk0x00/openclaw-gemini-stt-plugin#readme"
}
